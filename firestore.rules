rules_version = '2';

/**
 * CH Geladas PDV — Firestore Security Rules v4.2
 * ─────────────────────────────────────────────────────────────────────
 *
 * NOVIDADES v4.2:
 *   • saas_configs/{empresaId}    — configs individuais por tenant
 *   • saas_notifications/{id}     — notificações globais/individuais
 *   • saas_audit_log/{id}         — log imutável (allow delete: false)
 *   • checkEmpresaAtiva()         — bloqueia escrita em empresa suspensa
 *   • conviteValido() corrigido   — campo 'expiraEm' (era 'expiresAt')
 *   • saas_empresas update        — proteção de campos ownerId/id
 *
 * TABELA DE PERMISSÕES
 * ┌──────────────────────────────────┬─────────────────┬──────────────────────────────┐
 * │  Path                            │  Leitura        │  Escrita                     │
 * ├──────────────────────────────────┼─────────────────┼──────────────────────────────┤
 * │  saas_empresas/{id}              │  autenticado    │  create: autenticado válido  │
 * │                                  │                 │  update: adminToken ou dono  │
 * │  saas_usuarios/{uid}             │  autenticado    │  create/update: validado     │
 * │  saas_convites/{codigo}          │  autenticado    │  create: conviteValido()     │
 * │  saas_configs/{empresaId}        │  autenticado    │  adminToken                  │
 * │  saas_notifications/{id}         │  autenticado    │  create/update: adminToken   │
 * │                                  │                 │  delete: if false (imutável) │
 * │  saas_audit_log/{id}             │  adminToken     │  create: autenticado         │
 * │                                  │                 │  update/delete: NUNCA        │
 * │  saas_dados/{emp}/{col}/{doc}    │  autenticado    │  empresaId match + emp ativa │
 * │  billing_pedidos/{id}            │  autenticado    │  create livre / update admin │
 * │  saas_filiais_{emp}/{id}         │  autenticado    │  adminToken                  │
 * │  branding_{emp}/{id}             │  autenticado    │  adminToken                  │
 * └──────────────────────────────────┴─────────────────┴──────────────────────────────┘
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    //  FUNÇÕES AUXILIARES GLOBAIS
    // ════════════════════════════════════════════════════════════════

    function autenticado() {
      return request.auth != null;
    }

    function docValido(data) {
      return data.keys().hasAll(['dados', 'ts'])
          && data.ts is string
          && data.ts.size() > 0;
    }

    function temAdminToken(data) {
      return data.keys().hasAny(['adminToken'])
          && data.adminToken is string
          && data.adminToken.size() == 64;
    }

    function vendaValida(data) {
      return data.keys().hasAll(['id', 'total', 'itens', 'criadoEm'])
          && data.total is number
          && data.total >= 0
          && data.itens is list;
    }

    function movimentacaoValida(data) {
      return data.keys().hasAll(['produtoId', 'tipo', 'quantidade', 'timestamp'])
          && data.quantidade is number
          && data.timestamp  is string
          && data.timestamp.size() >= 10;
    }

    // v4.2 — campo corrigido para 'expiraEm' (era 'expiresAt' — bug anterior)
    function conviteValido(data) {
      return data.keys().hasAll(['codigo', 'empresaId', 'expiraEm'])
          && data.codigo    is string
          && data.empresaId is string
          && data.expiraEm  is string;
    }

    function billingPedidoValido(data) {
      return data.keys().hasAll(['empresaId', 'planoId', 'valor', 'txid', 'status'])
          && data.valor  is number
          && data.valor  > 0
          && data.status is string
          && data.status == 'aguardando';
    }

    // v4.2 — valida se empresa está ativa antes de permitir escrita de dados
    // Chamada nas regras de saas_dados para bloquear empresas suspensas
    function empresaAtiva(empresaId) {
      let emp = get(/databases/$(database)/documents/saas_empresas/$(empresaId));
      return emp.data.ativo == true
          && emp.data.get('status', 'ativo') != 'bloqueado';
    }

    // ════════════════════════════════════════════════════════════════
    //  SISTEMA LEGADO — CH GELADAS (coleções globais)
    // ════════════════════════════════════════════════════════════════

    match /ch_dados/{colecao} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && docValido(request.resource.data)
                   && temAdminToken(request.resource.data);
    }

    match /vendas/{vendaId} {
      allow create: if autenticado()
                    && vendaValida(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado()
                    && temAdminToken(request.resource.data);
      allow delete: if autenticado()
                    && temAdminToken(request.resource.data);
    }

    match /movimentacoes/{movId} {
      allow create: if autenticado()
                    && movimentacaoValida(request.resource.data);
      allow read:   if autenticado();
      allow update,
            delete: if autenticado()
                    && temAdminToken(request.resource.data);
    }

    match /categorias/{catId} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && temAdminToken(request.resource.data);
    }

    match /fornecedores/{fornId} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && temAdminToken(request.resource.data);
    }

    match /backups/{data}/snapshots/{snapshotId} {
      allow read:  if autenticado()
                   && temAdminToken(request.resource.data);
      allow write: if autenticado()
                   && temAdminToken(request.resource.data);
    }

    // ════════════════════════════════════════════════════════════════
    //  BILLING
    // ════════════════════════════════════════════════════════════════

    match /billing_pedidos/{pedidoId} {
      allow create: if autenticado()
                    && billingPedidoValido(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado()
                    && temAdminToken(request.resource.data);
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    //  MULTI-FILIAL E WHITE-LABEL
    // ════════════════════════════════════════════════════════════════

    match /saas_filiais_{empresaId}/{docId} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && temAdminToken(request.resource.data);
    }

    match /branding_{empresaId}/{docId} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && temAdminToken(request.resource.data);
    }

    // ════════════════════════════════════════════════════════════════
    //  SAAS — MULTI-TENANT
    // ════════════════════════════════════════════════════════════════

    // ── /saas_empresas/{empresaId} ───────────────────────────────────
    match /saas_empresas/{empresaId} {
      allow read: if autenticado();

      allow create: if autenticado()
                    && request.resource.data.keys().hasAll(
                         ['id','nome','plano','ownerId','ativo','criadoEm','status'])
                    && request.resource.data.id    == empresaId
                    && request.resource.data.ativo == true
                    && request.resource.data.status == 'ativo';

      allow update: if autenticado()
                    && (
                      // Super-admin pode atualizar tudo (usa adminToken)
                      temAdminToken(request.resource.data)
                      ||
                      // Usuário normal: não pode alterar ownerId, id, status, ativo
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['ownerId', 'id', 'status', 'ativo',
                                 'bloqueadoPor', 'bloqueadoEm', 'motivoBloqueio'])
                    );

      allow delete: if autenticado()
                    && temAdminToken(request.resource.data);
    }

    // ── /saas_usuarios/{uid} ─────────────────────────────────────────
    match /saas_usuarios/{uid} {
      allow read: if autenticado();

      allow create: if autenticado()
                    && request.resource.data.keys().hasAll(
                         ['id','empresaId','nome','senhaHash','role','ativo','criadoEm'])
                    && request.resource.data.id    == uid
                    && request.resource.data.ativo == true;

      allow update: if autenticado()
                    && (
                      temAdminToken(request.resource.data)
                      // Permite atualizar apenas campos não-sensíveis sem adminToken
                      || !request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['senhaHash','role','empresaId','id'])
                    );

      allow delete: if autenticado()
                    && temAdminToken(request.resource.data);
    }

    // ── /saas_convites/{codigo} ──────────────────────────────────────
    match /saas_convites/{codigo} {
      allow read:   if autenticado();
      allow create: if autenticado()
                    && conviteValido(request.resource.data);
      // Marcar como usado (update) é livre para autenticado (cliente usa o convite)
      allow update: if autenticado();
      allow delete: if autenticado()
                    && temAdminToken(request.resource.data);
    }

    // ── /saas_configs/{empresaId} — v4.2 NOVO ───────────────────────
    // Leitura: qualquer autenticado (carregada no login pelo podeAcessarModulo())
    // Escrita: somente adminToken (super-admin ou dono via adminToken gerado)
    match /saas_configs/{empresaId} {
      allow read:   if autenticado();
      allow create,
            update: if autenticado()
                    && temAdminToken(request.resource.data);
      allow delete: if false; // configs nunca deletadas, só sobrescritas
    }

    // ── /saas_notifications/{notifId} — v4.2 NOVO ───────────────────
    // Criação/atualização: adminToken
    // Leitura: qualquer autenticado (feed de notificações no hub)
    // Delete: NUNCA (arquivar = setar ativo:false)
    match /saas_notifications/{notifId} {
      allow read:   if autenticado();
      allow create: if autenticado()
                    && request.resource.data.keys().hasAll(
                         ['id','tipo','titulo','mensagem','escopo','criadoEm','ativo'])
                    && temAdminToken(request.resource.data);
      allow update: if autenticado()
                    && temAdminToken(request.resource.data);
      allow delete: if false; // arquivar via update ativo:false
    }

    // ── /saas_audit_log/{logId} — v4.2 NOVO (imutável) ──────────────
    // Criação: qualquer autenticado (saasService escreve internamente)
    // Leitura: somente adminToken (log sensível)
    // Update/Delete: NUNCA — registro imutável por design
    match /saas_audit_log/{logId} {
      allow create: if autenticado()
                    && request.resource.data.keys().hasAll(
                         ['id','acao','criadoEm']);
      allow read:   if autenticado()
                    && temAdminToken(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // ── /saas_dados/{empresaId}/{colecao}/{docId} ────────────────────
    // v4.2: acrescenta verificação empresaAtiva() para bloquear
    //       gravação de empresas suspensas mesmo se o JS for burlado
    match /saas_dados/{empresaId}/{colecao}/{docId} {
      allow read: if autenticado();

      allow write: if autenticado()
                   && empresaAtiva(empresaId)   // v4.2 — NOVO guard
                   && (
                     temAdminToken(request.resource.data)
                     ||
                     (
                       request.resource.data.keys().hasAny(['empresaId'])
                       && request.resource.data.empresaId == empresaId
                     )
                     || !request.resource.data.keys().hasAny(['empresaId'])
                   );
    }

    // ── Bloqueia TUDO não mapeado explicitamente ─────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
